# Aldine — bubble-robotics instance, co-hosted on the GitLab box behind
# GitLab's bundled nginx. Compose reads this file automatically for every
# `docker compose` call made from this directory.
#
# Give each comment its own line: anything after a value becomes part of the
# value, so `AUTH_ENABLED=1  # login` is not `1` and auth silently stays off.

# ---- ingress -------------------------------------------------------------
# Absolute origin used to build the Google callback URL. Must match the
# authorised redirect URI in the Google console character for character.
ALDINE_PUBLIC_URL=https://aldine.bubble-robotics.com
# Loopback only: nginx is the sole thing that talks to the app.
ALDINE_APP_BIND=127.0.0.1
# 8080 is GitLab's Puma. Anything free works; deploy/nginx.aldine.conf expects 8090.
ALDINE_PORT=8090

# Saves repeating -f flags: every `docker compose` call in this directory then
# means the full stack + prod overrides + published images. Uncomment on the
# server; leave it off in a dev checkout, where it would change every call.
#COMPOSE_FILE=docker-compose.full.yml:deploy/docker-compose.prod.yml:images.yml

# ---- auth ----------------------------------------------------------------
AUTH_ENABLED=1
# Sign-in is exclusively Google: no password endpoints, so no SMTP needed and
# no password-reset path to secure.
ALDINE_SSO_ONLY=1
# A SECOND OAuth client (type "Web") in the same Cloud project as the GitLab
# one — shared consent screen, separate secret.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- GitLab -------------------------------------------------------------
# This instance is co-hosted with GitLab, so the app container reaches it over
# the public hostname and hairpins back through nginx. If that fails (some NAT
# setups don't hairpin), add to the app service instead of changing this URL:
#   extra_hosts: ["gitlab.bubble-robotics.com:host-gateway"]
# nginx still picks the right vhost by Host header, so the certificate matches.
GITLAB_URL=https://gitlab.bubble-robotics.com

# Applies to every locally-created project: blank, from a template, or imported
# from a ZIP (Overleaf exports included). A project imported from GitHub or
# GitLab keeps the remote it came from.
#
# Makes a GitLab group the home for new projects: BOTH of these must be set,
# or the feature stays off and projects are local-only.
#
# GITLAB_TOKEN is a service-account personal access token with `api` scope.
# Create it on a bot account that is an Owner of the group below. Maintainer is
# enough to create projects and subgroups, but GitLab lets only an Owner delete
# a project — with Maintainer, trashing a project in Aldine leaves its GitLab
# project behind and the log says "403 Forbidden". Everything Aldine creates is
# owned by that account.
#
# Trade-off to be aware of: every Aldine user effectively gains write access to
# this group through the bot. Git commit authorship is still the real user
# (Aldine sets --author on every autocommit) — only the push is the bot. If you
# need exact GitLab-side attribution, leave GITLAB_TOKEN blank and have people
# connect their own GitLab accounts from the editor instead.
GITLAB_TOKEN=
# Full path of the group, as it appears in a GitLab URL. Subgroups can be
# created from Aldine's New project dialog, so this is just the root.
# Trashing a project in Aldine deletes its GitLab project (only ones Aldine
# created — never an imported repo). Restore re-creates it from the local repo,
# so content returns; GitLab merge requests, issues and CI history do not.
# GitLab keeps a deleted project for its retention period, so Aldine follows up
# with an immediate purge. Instances that reserve immediate deletion for admins
# refuse that; the project then disappears on GitLab's own schedule and Aldine
# says so instead of claiming it is gone.
GITLAB_DEFAULT_GROUP=it/latex
# private (default) | internal | public — visibility of auto-created projects.
GITLAB_DEFAULT_VISIBILITY=private

# ---- project templates ---------------------------------------------------
# A GitLab group whose projects are offered as starting points in the New
# project dialog. One project per template; the group may have subgroups.
# Independent of GITLAB_DEFAULT_GROUP — templates can come from GitLab even if
# new projects stay local, and vice versa. Reuses GITLAB_TOKEN above, so the
# bot account needs at least Reporter on this group.
#
# Per template, optionally commit a template.json at the repo root to control
# how the tile looks; without one, the GitLab project's own name and
# description are used:
#   { "name": "IEEE paper", "description": "Two-column manuscript",
#     "icon": "📐", "order": 2 }
#
# A template's main.tex may use these placeholders, filled in at creation:
#   {{PROJECT_NAME}}  {{AUTHOR}}  {{DATE}} (YYYY-MM-DD)  {{YEAR}}
#
# Templates are copied, not linked: the new project keeps no connection to the
# template repo, so editing a template never touches projects made from it.
#GITLAB_TEMPLATE_GROUP=it/latex/templates

# Templates on disk, offered alongside (or instead of) the GitLab ones. One
# subdirectory per template; any folder holding a .tex file counts, and
# template.json is optional. Scanned per request, so a template dropped in
# appears without a restart. Aldine ships four at /srv/templates in the
# container — point this at a mounted directory to use your own instead. If you
# set this in docker compose, mount the directory into the app service too.
#TEMPLATES_DIR=/srv/templates

# Not needed for the above. These add one-click "Connect with GitLab" for users
# importing their own repos; a personal access token works without them.
#GITLAB_CLIENT_ID=
#GITLAB_CLIENT_SECRET=

# ---- optional, deliberately off ------------------------------------------
# AI error-fix (bring your own key; unset = feature hidden)
#OPENROUTER_API_KEY=
# per-user compile minutes per month; blank = uncapped
#ALDINE_COMPILE_QUOTA_MIN=
#SENTRY_DSN=
