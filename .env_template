# Aldine — bubble-robotics instance, co-hosted on the GitLab box behind
# GitLab's bundled nginx. Compose reads this file automatically for every
# `docker compose` call made from this directory.
#
# Give each comment its own line: anything after a value becomes part of the
# value, so `AUTH_ENABLED=1  # login` is not `1` and auth silently stays off.

# ---- ingress -------------------------------------------------------------
# Absolute origin used to build the Google callback URL. Must match the
# authorised redirect URI in the Google console character for character.
ALDINE_PUBLIC_URL=https://aldine.bubble-robotics.com
# Loopback only: nginx is the sole thing that talks to the app.
ALDINE_APP_BIND=127.0.0.1
# 8080 is GitLab's Puma. Anything free works; deploy/nginx.aldine.conf expects 8090.
ALDINE_PORT=8090

# Saves repeating -f flags: every `docker compose` call in this directory then
# means the full stack + prod overrides + published images. Uncomment on the
# server; leave it off in a dev checkout, where it would change every call.
#COMPOSE_FILE=docker-compose.full.yml:deploy/docker-compose.prod.yml:images.yml

# ---- auth ----------------------------------------------------------------
AUTH_ENABLED=1
# Sign-in is exclusively Google: no password endpoints, so no SMTP needed and
# no password-reset path to secure.
ALDINE_SSO_ONLY=1
# A SECOND OAuth client (type "Web") in the same Cloud project as the GitLab
# one — shared consent screen, separate secret.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- optional, deliberately off ------------------------------------------
# AI error-fix (bring your own key; unset = feature hidden)
#OPENROUTER_API_KEY=
# per-user compile minutes per month; blank = uncapped
#ALDINE_COMPILE_QUOTA_MIN=
#SENTRY_DSN=
